<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Categories</h1>
    <%= link_to "New Category", new_category_path, class: "btn btn-primary" %>
  </div>

  <% if @categories.any? %>
    <div class="row">
      <% @categories.each do |category| %>
        <div class="col-md-4 mb-3">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="card-title">
                <%= link_to category.name, category_path(category), class: "text-decoration-none" %>
              </h5>
              <p class="card-text text-muted">
                <%= category.description %>
              </p>
            </div>

            <div class="card-footer d-flex justify-content-between">
              <%= link_to "Edit", edit_category_path(category), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Delete", delete_category_path(category), class: "btn btn-sm btn-outline-danger" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      No categories yet. Click "New Category" to get started.
    </div>
  <% end %>
</div>