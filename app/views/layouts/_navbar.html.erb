<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">

    <%= link_to "TodoApp", root_path, class: "navbar-brand" %>

    <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">

      <% if logged_in? %>

        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <%= link_to "ToDos", todos_path, class: "nav-link" %>
          </li>

          <li class="nav-item">
            <%= link_to "Categories", categories_path, class: "nav-link" %>
          </li>

          <li class="nav-item">
            <%= link_to "Completed ToDos", completed_todos_path, class: "nav-link" %>
          </li>
        </ul>

        <ul class="navbar-nav">
          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle"
               href="#"
               id="profileDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">

              <i class="fa-solid fa-user"></i>
              <%= current_user.first_name %>
            </a>

            <ul class="dropdown-menu dropdown-menu-end"
                aria-labelledby="profileDropdown">

              <li>
                <%= button_to "Delete Account",
                    user_path(current_user),
                    method: :delete,
                    class: "dropdown-item text-danger",
                    form: {
                      data: {
                        turbo_confirm: "This will permanently delete your account and all your data. Are you sure?"
                      }
                    } %>
              </li>

              <li>
                <hr class="dropdown-divider">
              </li>

              <li>
                <%= link_to "Logout",
                    logout_path,
                    class: "dropdown-item" %>
              </li>

            </ul>

          </li>
        </ul>

      <% else %>

        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <%= link_to "Log In", login_path, class: "nav-link" %>
          </li>

          <li class="nav-item">
            <%= link_to "Sign Up", signup_path, class: "nav-link" %>
          </li>

        </ul>

      <% end %>

    </div>
  </div>
</nav>