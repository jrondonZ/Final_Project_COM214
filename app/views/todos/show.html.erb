<h1><%= @todo.title %></h1>

<p>Priority: <%= @todo.priority ? "Yes" : "No" %></p>
<p>Status: <%= @todo.completed ? "Completed" : "Pending" %></p>
<p>Category: <%= @todo.category&.name || "None" %></p>

<%= link_to "Edit", edit_todo_path(@todo), class: "btn btn-warning" %>
<%= link_to "Delete", todo_path(@todo), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" %>
<%= link_to "Back", todos_path, class: "btn btn-secondary" %>