<h1>New ToDo</h1>

<%= form_with model: @todo, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :category_id, "Category", class: "form-label" %>
    <%= f.collection_select :category_id, current_user.categories, :id, :name, { prompt: "Select a category" }, class: "form-select" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :priority, class: "form-check-input" %>
    <%= f.label :priority, class: "form-check-label" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :completed, class: "form-check-input" %>
    <%= f.label :completed, class: "form-check-label" %>
  </div>

  <%= f.submit "Create ToDo", class: "btn btn-primary" %>
<% end %>

<%= link_to "Back", todos_path, class: "btn btn-secondary mt-2" %>