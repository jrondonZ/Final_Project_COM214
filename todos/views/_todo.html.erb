<div id="<%= dom_id todo %>" class="card mb-3 todo-card <%= 'todo-completed' if todo.completed %> <%= 'todo-priority' if todo.priority %>">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <div class="flex-grow-1">
        <h5 class="card-title">
          <% if todo.completed %>
            <i class="fas fa-check-circle text-success"></i>
          <% elsif todo.priority %>
            <i class="fas fa-exclamation-circle text-danger"></i>
          <% else %>
            <i class="fas fa-circle text-secondary" style="font-size: 0.6em;"></i>
          <% end %>
          <%= todo.title %>
        </h5>
        
        <div class="mb-2">
          <small class="text-muted">
            <i class="fas fa-folder"></i> 
            <strong>Category:</strong> 
            <% if todo.category %>
              <%= link_to todo.category.name, category_path(todo.category), class: "text-decoration-none" %>
            <% else %>
              <span class="text-danger">Uncategorized</span>
            <% end %>
          </small>
        </div>

        <div class="badge-container">
          <% if todo.priority %>
            <span class="badge bg-danger"><i class="fas fa-star"></i> High Priority</span>
          <% end %>
          <% if todo.completed %>
            <span class="badge bg-success"><i class="fas fa-check"></i> Completed</span>
          <% else %>
            <span class="badge bg-warning"><i class="fas fa-clock"></i> Pending</span>
          <% end %>
        </div>
      </div>

      <div class="btn-group-vertical btn-group-sm" role="group">
        <%= link_to edit_todo_path(todo), class: "btn btn-outline-primary" do %>
          <i class="fas fa-edit"></i> Edit
        <% end %>
        <%= link_to todo_path(todo), class: "btn btn-outline-info" do %>
          <i class="fas fa-eye"></i> View
        <% end %>
        <%= link_to todo_path(todo), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger" do %>
          <i class="fas fa-trash"></i> Delete
        <% end %>
      </div>
    </div>
  </div>
</div>
