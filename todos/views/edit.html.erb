<% content_for :title, "Edit Todo - #{@todo.title}" %>

<div class="row">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header bg-warning text-dark">
        <h3 class="card-title mb-0">
          <i class="fas fa-pencil"></i> Edit Todo
        </h3>
      </div>
      <div class="card-body">
        <%= render "form", todo: @todo %>
      </div>
    </div>
  </div>
</div>
