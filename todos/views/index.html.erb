<% content_for :title, "My Todos" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="fas fa-tasks"></i> My Todos</h1>
  <%= link_to new_todo_path, class: "btn btn-primary btn-lg" do %>
    <i class="fas fa-plus"></i> New Todo
  <% end %>
</div>

<% if @todos.any? %>
  <div class="todos-container">
    <% @todos.each do |todo| %>
      <%= render todo %>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info text-center py-5">
    <h3 class="mt-3">No todos yet!</h3>
    <p class="text-muted">Create your first todo to get started.</p>
    <%= link_to "Create a Todo", new_todo_path, class: "btn btn-primary mt-3" %>
  </div>
<% end %>
