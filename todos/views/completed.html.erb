<% content_for :title, "Completed Todos" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="fas fa-check-circle text-success"></i> Completed Todos</h1>
  <%= link_to todos_path, class: "btn btn-outline-primary" do %>
    <i class="fas fa-list"></i> All Todos
  <% end %>
</div>

<% if @completed_todos.any? %>
  <div class="todos-container">
    <% @completed_todos.each do |todo| %>
      <%= render todo %>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info text-center py-5">
    <h3 class="mt-3">No completed todos yet!</h3>
    <p class="text-muted">Complete some todos to see them here.</p>
    <%= link_to "Go to All Todos", todos_path, class: "btn btn-primary mt-3" %>
  </div>
<% end %>
